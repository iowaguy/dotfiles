  fingerprintX1_2021 = {
    "eDP-1" =
      "";
  };
  fingerprintLGHome = {
    "HDMI-1" =
      "";
  };
  fingerprintLGHomeDongle = {
    "DP-3" =
      "";
  };
  fingerprintLucyThinkVision = {
    "DP-2" =
      "";
  };
  fingerprintHomeViewSonic = {
    "DP-2" =
    "";
  };
  x1Config = {
    eDP-1 = {
      enable = true;
      primary = true;
      mode = "3840x2400";
      position = "0x0";
      crtc = 0;
    };
  };
  lucyConfig = {
    DP-2 = {
      primary = true;
      enable = true;
      mode = "1920x1080";
      crtc = 1;
      position = "3841x0";

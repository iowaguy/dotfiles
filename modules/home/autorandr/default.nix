      rate = "60.00";
    };
  };
  lgHomeDongleConfig = {
    DP-2 = {
      primary = true;
      enable = true;
      mode = "1920x1080";
      crtc = 1;
      position = "3841x0";
      rate = "60.00";

      # needed for lower resolution external monitor (1920x1080)
      transform = [
